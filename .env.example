# ─────────────────────────────────────────────────────────────────
# JobNest – Environment Variables
# Copy this file to .env in the root and server/ directories.
# ─────────────────────────────────────────────────────────────────

# ── Server (server/.env) ─────────────────────────────────────────
# Port the Express server listens on (default: 5000)
PORT=5000

# Set to "production" when deploying
NODE_ENV=production

# JWT signing secret — use a long random string in production!
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of allowed frontend origins for CORS.
# Only needed if frontend and backend are deployed to DIFFERENT domains.
# Example: CLIENT_ORIGIN=https://jobnest.example.com
# In production with same-origin deployment (Express serves the built React app),
# you can leave this unset.
# CLIENT_ORIGIN=https://jobnest.example.com

# ── Frontend (root .env) ──────────────────────────────────────────
# Only set this if your frontend is deployed to a DIFFERENT origin than the backend.
# Leave unset for same-origin deployments (Express serves the built React app).
# VITE_API_URL=https://api.jobnest.example.com
